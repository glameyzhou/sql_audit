<?xml version="1.0" encoding="UTF-8"?>
<!--
  Log4j2 配置（server 进程；worker 独立部署时复用本文件）。

  口径（可观测性）：
  - console：人看的（开发/容器 stdout 采集）；
  - app 滚动文件：sqlaudit-app.log，业务日志（INFO+）；
  - error 单独文件：sqlaudit-error.log，供告警脚本 tail（企微告警 W2 后段接）；
  - 审计不走路由到文件——审计链在 audit_log 表（hash 链），日志仅作运维排障。
-->
<Configuration status="WARN">
    <Properties>
        <Property name="LOG_DIR">${sys:LOG_DIR:-logs}</Property>
        <Property name="PATTERN">%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</Property>
    </Properties>

    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${PATTERN}"/>
        </Console>

        <RollingFile name="AppFile"
                     fileName="${LOG_DIR}/sqlaudit-app.log"
                     filePattern="${LOG_DIR}/sqlaudit-app-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${PATTERN}"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="100 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="14"/>
        </RollingFile>

        <RollingFile name="ErrorFile"
                     fileName="${LOG_DIR}/sqlaudit-error.log"
                     filePattern="${LOG_DIR}/sqlaudit-error-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${PATTERN}"/>
            <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
            <Policies>
                <TimeBasedTriggeringPolicy/>
                <SizeBasedTriggeringPolicy size="50 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="14"/>
        </RollingFile>
    </Appenders>

    <Loggers>
        <!-- SQL 明文不进日志（敏感数据只进审计链的加密 detail），框架 SQL 调试时手动调 -->
        <Logger name="org.springframework" level="WARN"/>
        <Logger name="org.apache" level="WARN"/>

        <Root level="INFO">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="AppFile"/>
            <AppenderRef ref="ErrorFile"/>
        </Root>
    </Loggers>
</Configuration>
