<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.sqlaudit</groupId>
        <artifactId>sqlaudit</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>sqlaudit-server</artifactId>
    <name>sqlaudit-server</name>
    <description>API / Web 入口（W2 集成；关闭任务轮询开关）</description>
    <dependencies>
        <dependency>
            <groupId>com.sqlaudit</groupId>
            <artifactId>sqlaudit-auth</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sqlaudit</groupId>
            <artifactId>sqlaudit-workflow</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sqlaudit</groupId>
            <artifactId>sqlaudit-audit</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sqlaudit</groupId>
            <artifactId>sqlaudit-rule</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sqlaudit</groupId>
            <artifactId>sqlaudit-parser</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sqlaudit</groupId>
            <artifactId>sqlaudit-rollback</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sqlaudit</groupId>
            <artifactId>sqlaudit-query</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sqlaudit</groupId>
            <artifactId>sqlaudit-storage</artifactId>
        </dependency>

        <!-- Web 容器与 REST -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <exclusions>
                <!-- 换 Log4j2：排除 starter 默认的 Logback -->
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-logging</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
        </dependency>
        <!-- MySQL 存储（profile=mysql 时启用 JDBC 真 DAO；默认 memory 无库可跑） -->
        <dependency>
            <groupId>com.sqlaudit</groupId>
            <artifactId>sqlaudit-storage</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>
        <!-- 查询通道演示用 H2（生产替换为生产库只读副本连接池，见 ConnectionProvider javadoc） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
