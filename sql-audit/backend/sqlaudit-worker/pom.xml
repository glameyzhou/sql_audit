<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.sqlaudit</groupId>
        <artifactId>sqlaudit</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>sqlaudit-worker</artifactId>
    <name>sqlaudit-worker</name>
    <description>executor + query 运行进程（W2 集成；开启任务轮询）</description>
    <dependencies>
        <dependency>
            <groupId>com.sqlaudit</groupId>
            <artifactId>sqlaudit-executor</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sqlaudit</groupId>
            <artifactId>sqlaudit-query</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sqlaudit</groupId>
            <artifactId>sqlaudit-storage</artifactId>
        </dependency>
        <!-- GatewayBridge 现场构造前镜像（parser + rollback 的 PreimagePlanner） -->
        <dependency>
            <groupId>com.sqlaudit</groupId>
            <artifactId>sqlaudit-parser</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sqlaudit</groupId>
            <artifactId>sqlaudit-rollback</artifactId>
        </dependency>
        <!-- 执行前门禁（README §4.2）：WorkerLoop 的 ticketCanExecute 过滤直接依赖审批流引擎的 canExecute -->
        <dependency>
            <groupId>com.sqlaudit</groupId>
            <artifactId>sqlaudit-workflow</artifactId>
        </dependency>
        <!-- WorkerGateContext 直接 import RuleEngine / TableMetadataProvider（回滚能力复核） -->
        <dependency>
            <groupId>com.sqlaudit</groupId>
            <artifactId>sqlaudit-rule</artifactId>
        </dependency>
        <!-- worker 内嵌运行（可选独立进程） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- 日志门面：实现由宿主提供（server 内嵌=Log4j2；独立进程引 log4j-slf4j2-impl） -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- JdbcProductionGatewayIT 对本地 Docker MySQL 的集成测试（无库时 Assumptions 跳过） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- surefire 默认只匹配 *Test，补上 *IT（生产库端到端集成测试；
                 MySQL 不可用时测试类内用 Assumptions 优雅跳过，不会红） -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
