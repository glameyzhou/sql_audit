<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.sqlaudit</groupId>
    <artifactId>sqlaudit</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>sqlaudit</name>
    <description>SQL 审核平台（内部工具：SQL 审核 + 回滚生成 + 查询通道 + 全量审计）</description>

    <modules>
        <module>sqlaudit-common</module>
        <module>sqlaudit-storage</module>
        <module>sqlaudit-parser</module>
        <module>sqlaudit-rule</module>
        <module>sqlaudit-rollback</module>
        <module>sqlaudit-executor</module>
        <module>sqlaudit-query</module>
        <module>sqlaudit-auth</module>
        <module>sqlaudit-workflow</module>
        <module>sqlaudit-audit</module>
        <module>sqlaudit-server</module>
        <module>sqlaudit-worker</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring-boot.version>3.3.5</spring-boot.version>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <druid.version>1.2.23</druid.version>
        <iotdb.version>2.0.11</iotdb.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot BOM：统一管理 jackson / junit / flyway / mysql-connector-j 等版本 -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <!-- MySQL/PG SQL 解析（AST 归一化 + 只读判定，README §4.3） -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>druid</artifactId>
                <version>${druid.version}</version>
            </dependency>
            <!-- Apache IoTDB JDBC 驱动（连接测试 + 线上查询，README §5.2 目标库 2.0.11） -->
            <dependency>
                <groupId>org.apache.iotdb</groupId>
                <artifactId>iotdb-jdbc</artifactId>
                <version>${iotdb.version}</version>
            </dependency>
            <!-- 内部模块 -->
            <dependency>
                <groupId>com.sqlaudit</groupId>
                <artifactId>sqlaudit-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sqlaudit</groupId>
                <artifactId>sqlaudit-storage</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sqlaudit</groupId>
                <artifactId>sqlaudit-parser</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sqlaudit</groupId>
                <artifactId>sqlaudit-rule</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sqlaudit</groupId>
                <artifactId>sqlaudit-rollback</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sqlaudit</groupId>
                <artifactId>sqlaudit-executor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sqlaudit</groupId>
                <artifactId>sqlaudit-query</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sqlaudit</groupId>
                <artifactId>sqlaudit-auth</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sqlaudit</groupId>
                <artifactId>sqlaudit-workflow</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.sqlaudit</groupId>
                <artifactId>sqlaudit-audit</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>21</release>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
